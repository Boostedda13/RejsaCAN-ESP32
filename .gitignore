# KiCad -- local/generated files, not design sources
# (git does not support trailing comments on pattern lines)

# per-user project display settings
*.kicad_prl
# auto-save backups
*-backups/
# footprint cache
fp-info-cache
# KiCad 10 local history (contains its own nested git repo)
.history/
# editor lock files
*.lck
# intermediate backups from scripted edits
*.bak
# generated manufacturing output (see KiCad/fabrication/README.md)
**/KiCad/fabrication/*
!**/KiCad/fabrication/README.md
# scratch output of the routing/stitching tools (see KiCad/tools/README.md)
**/KiCad/tools/out/

# Python bytecode (converter/)
__pycache__/
*.pyc

# OS cruft
Thumbs.db
.DS_Store

# personal Claude notes
.claude.local.md

# Electron/Chromium log JLCEDA Pro drops in whatever directory it opens
debug.log
